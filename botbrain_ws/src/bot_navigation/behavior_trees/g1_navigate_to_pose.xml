<!--
  Keep a valid global plan stable while the local controller handles transient
  scan obstacles. Replan when the goal changes, or after a persistent FollowPath
  failure reaches the outer recovery. This prevents a flickering global scan
  cell from alternating between a short path and a map-sized detour.
  Automatic spin and backup recoveries are intentionally omitted because they
  can increase foot slip and FAST-LIO attitude transients on smooth floors.
-->
<root main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <RecoveryNode number_of_retries="4" name="NavigateRecovery">
      <PipelineSequence name="NavigateWithStableReplanning">
        <GoalUpdatedController name="PlanOnGoalUpdate">
          <RecoveryNode number_of_retries="1" name="ComputePathRecovery">
            <ComputePathToPose
              goal="{goal}"
              path="{path}"
              planner_id="GridBased"/>
            <ClearEntireCostmap
              name="ClearGlobalCostmapContext"
              service_name="global_costmap/clear_entirely_global_costmap"/>
          </RecoveryNode>
        </GoalUpdatedController>
        <RecoveryNode number_of_retries="1" name="FollowPathRecovery">
          <FollowPath
            path="{path}"
            controller_id="FollowPath"
            goal_checker_id="general_goal_checker"/>
          <Sequence name="RefreshLocalCostmapAfterFollowPathFailure">
            <ClearEntireCostmap
              name="ClearLocalCostmapContext"
              service_name="local_costmap/clear_entirely_local_costmap"/>
            <!-- Let a fresh /scan repopulate the local costmap before retry. -->
            <Wait wait_duration="0.5"/>
          </Sequence>
        </RecoveryNode>
      </PipelineSequence>
      <ReactiveFallback name="RecoveryFallback">
        <GoalUpdated/>
        <RoundRobin name="StationaryRecoveryActions">
          <Sequence name="ClearCostmaps">
            <ClearEntireCostmap
              name="ClearLocalCostmap"
              service_name="local_costmap/clear_entirely_local_costmap"/>
            <ClearEntireCostmap
              name="ClearGlobalCostmap"
              service_name="global_costmap/clear_entirely_global_costmap"/>
            <ComputePathToPose
              goal="{goal}"
              path="{path}"
              planner_id="GridBased"/>
          </Sequence>
          <Wait wait_duration="2"/>
        </RoundRobin>
      </ReactiveFallback>
    </RecoveryNode>
  </BehaviorTree>
</root>
