NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
PORT=3000

# Mission Supervisor API defaults used by the Mission Control page.
MISSION_SUPERVISOR_URL=http://127.0.0.1:8787
NEXT_PUBLIC_MISSION_SUPERVISOR_URL=http://127.0.0.1:8787
MISSION_SUPERVISOR_PROXY_TIMEOUT_MS=8000
# Optional client-side guard; global middleware still requires Supabase login.
NEXT_PUBLIC_REQUIRE_AUTH_FOR_MISSION_CONTROL=false

# Local mock G1 rosbridge endpoint for Mission Control/Health development only.
# The production robot connection should continue to use the real G1 rosbridge host.
MOCKG1_HOST=127.0.0.1
MOCKG1_PORT=9090
MOCKG1_SCENARIO=default
MOCKG1_NAMESPACE=
MOCKG1_CAMERA_FPS=5
MOCKG1_LOG_LEVEL=info

# Use these only when running against mockg1 instead of the Unitree G1 EDU.
# scripts/run-mockg1-bt-stack.sh injects them automatically for the frontend dev server.
# NEXT_PUBLIC_ROS_IP=127.0.0.1
# NEXT_PUBLIC_ROS_PORT=9090
